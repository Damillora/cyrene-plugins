pub fn get_versions() {
    versions::from_github("Damillora/flora")
}

pub fn install_app(env) {
    sources::from_tar_xz(`https://github.com/Damillora/flora/releases/download/v${env.version}/flora_cli-x86_64-unknown-linux-gnu.tar.xz`);
}

pub fn binaries(env) {
    [("flora", "flora_cli-x86_64-unknown-linux-gnu/flora")]
}

pub fn post_install(env) {

}
