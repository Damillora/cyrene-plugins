pub fn get_versions() {
    versions::from_github("neovim/neovim")
}

pub fn install_app(env) {
    sources::from_tar_gz(`https://github.com/neovim/neovim/releases/download/v${env.version}/nvim-linux-x86_64.tar.gz`);
}

pub fn binaries(env) {
    [("nvim", "nvim-linux-x86_64/bin/nvim")]
}

pub fn post_install(env) {

}
