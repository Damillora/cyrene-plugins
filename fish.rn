pub fn get_versions() {
    versions::from_github("fish-shell/fish-shell")
}

pub fn install_app(env) {
    sources::from_tar_xz(`https://github.com/fish-shell/fish-shell/releases/download/${env.version}/fish-${env.version}-linux-x86_64.tar.xz`);
}

pub fn binaries(env) {
    [("fish", "fish")]
}

pub fn post_install(env) {

}
