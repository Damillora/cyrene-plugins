pub fn get_versions() {
    versions::from_github("zed-industries/zed")
}

pub fn install_app(env) {
    sources::from_tar_gz(`https://github.com/zed-industries/zed/releases/download/v${env.version}/zed-linux-x86_64.tar.gz`);
}

pub fn binaries(env) {
    [("zed", "zed.app/bin/zed")]
}

pub fn post_install(env) {

}
