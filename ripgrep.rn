pub fn get_versions() {
    versions::from_github("BurntSushi/ripgrep")
}

pub fn install_app(env) {
    sources::from_tar_gz(`https://github.com/BurntSushi/ripgrep/releases/download/${env.version}/ripgrep-${env.version}-x86_64-unknown-linux-musl.tar.gz`)
}

pub fn binaries(env) {
    [("rg", `ripgrep-${env.version}-x86_64-unknown-linux-musl/rg`)]
}

pub fn post_install(env) {

}
