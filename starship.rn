pub fn get_versions() {
    versions::from_github("starship/starship")
}

pub fn install_app(env) {
    sources::from_tar_gz(`https://github.com/starship/starship/releases/download/v${env.version}/starship-x86_64-unknown-linux-gnu.tar.gz`);
}

pub fn binaries(env) {
    [("starship", "starship")]
}

pub fn post_install(env) {

}
