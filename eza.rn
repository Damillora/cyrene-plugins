pub fn get_versions() {
    versions::from_github("eza-community/eza")
}

pub fn install_app(env) {
    sources::from_tar_gz(`https://github.com/eza-community/eza/releases/download/v${env.version}/eza_x86_64-unknown-linux-gnu.tar.gz`);
}

pub fn binaries(env) {
    [("eza", "eza")]
}

pub fn post_install(env) {

}
