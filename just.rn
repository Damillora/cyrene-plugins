pub fn get_versions() {
    versions::from_github("casey/just")
}

pub fn install_app(env) {
    sources::from_tar_gz(`https://github.com/casey/just/releases/download/${env.version}/just-${env.version}-x86_64-unknown-linux-musl.tar.gz`);
}

pub fn binaries(env) {
    [("just", "just")]
}

pub fn post_install(env) {

}
