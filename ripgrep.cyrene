[settings]
upgrade_latest = true

[versions]
type = "github"
repo = "BurntSushi/ripgrep"

[[sources]]
type = "tar_gz"
url = "https://github.com/BurntSushi/ripgrep/releases/download/${version}/ripgrep-${version}-x86_64-unknown-linux-musl.tar.gz"

[binaries]
rg = "ripgrep-${version}-x86_64-unknown-linux-musl/rg"
