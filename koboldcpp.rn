pub fn get_versions() {
    versions::from_github("LostRuins/koboldcpp")
}

pub fn install_app(env) {
    sources::from_file(`https://github.com/LostRuins/koboldcpp/releases/download/v${env.version}/koboldcpp-linux-x64-nocuda`);
    modify::set_exec("koboldcpp-linux-x64-nocuda");
}

pub fn binaries(env) {
    [("koboldcpp", "koboldcpp-linux-x64-nocuda")]
}

pub fn post_install(env) {

}
