pub fn get_versions() {
    versions::from_github("securego/gosec")
}

pub fn install_app(env) {
    sources::from_tar_gz(`https://github.com/securego/gosec/releases/download/v${env.version}/gosec_${env.version}_linux_amd64.tar.gz`)
}

pub fn binaries(env) {
    [("gosec", "gosec")]
}

pub fn post_install(env) {

}
