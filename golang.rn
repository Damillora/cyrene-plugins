pub fn get_versions() {
    let response = versions::from_json("https://go.dev/dl/?mode=json&include=all");
    let versions = response.iter().map(|e| e.version.strip_prefix("go") ).collect::<Vec>();
    versions
}

pub fn install_app(env) {
    sources::from_tar_gz(`https://go.dev/dl/go${env.version}.linux-amd64.tar.gz`);
}

pub fn binaries(env) {
    [("go", "go/bin/go"),
    ("gofmt", "go/bin/gofmt")]
}

pub fn post_install(env) {

}
