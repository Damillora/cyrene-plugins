[settings]
upgrade_latest = false

[versions]
type = "github"
repo = "sigstore/cosign"

[[sources]]
type = "file"
url = "https://github.com/sigstore/cosign/releases/download/v${version}/cosign-linux-amd64"

[binaries]
cosign = "cosign-linux-amd64"

[[post_install]]
type = "set_exec"
path = "cosign-linux-amd64"