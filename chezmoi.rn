pub fn get_versions() {
    versions::from_github("twpayne/chezmoi")
}

pub fn install_app(env) {
    sources::from_file(`https://github.com/twpayne/chezmoi/releases/download/v${env.version}/chezmoi-linux-amd64`);
    modify::set_exec("chezmoi-linux-amd64");
}

pub fn binaries(env) {
    [("chezmoi", "chezmoi-linux-amd64")]
}

pub fn post_install(env) {

}
